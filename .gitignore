# Доки-источники (~58 МБ, 9k файлов) — не коммитим, восстанавливаются скриптами fetch_*.py
wiki-lua/

# Python (только артефакты — сами скрипты tools/ коммитятся)
__pycache__/
*.pyc
*.py[cod]
.venv/

# Служебное (относительный путь — абсолютный C:\... в gitignore не работает)
.tmp/opencode/
*.log
.DS_Store
Thumbs.db

# Временные рабочие файлы агента (см. AGENTS.md п.11) — не коммитить
.temp/
